# Supabase project URL and anon/public key.
# Used by server-side auth routes; do not add service_role credentials here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Vercel AI Gateway (server-only; never use NEXT_PUBLIC_).
# On Vercel Preview, Vercel OIDC can be used instead of this key when enabled.
# For local development, create a Gateway key and set it here.
AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_API_KEY
HEALTH_ASSISTANT_MODEL=google/gemini-4-neon
# Draft AI answers are allowed only in local development or Vercel Preview.
# Production is always evidence-only while clinical review is pending.
HEALTH_ASSISTANT_ENABLE_DRAFT_ANSWERS=true
# Optional override for a compatible provider; defaults to Vercel AI Gateway.
# HEALTH_ASSISTANT_CHAT_ENDPOINT=https://ai-gateway.vercel.sh/v1/chat/completions

# Local-only Ollama RAG (Next.js development only; never set on Vercel)
HEALTH_ASSISTANT_PROVIDER=ollama-local
HEALTH_ASSISTANT_MODEL=qwen3.5:0.8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
LOCAL_HEALTH_RAG_MIN_SIMILARITY=0.30
