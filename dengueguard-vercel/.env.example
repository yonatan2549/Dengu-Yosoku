# Supabase project URL and anon/public key.
# Used by server-side auth routes; do not add service_role credentials here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Local development only: Python RAG project used by /api/health-assistant.
# Put these values in .env.local, not in Vercel Production.
DENGUE_RAG_PROJECT_DIR=D:\AI\DengueYosoku
DENGUE_RAG_PYTHON=py
